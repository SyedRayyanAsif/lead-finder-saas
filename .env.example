# Copy this file to `.env.local` and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API
#
# Only the "anon" / public key belongs here. It is safe to ship in the browser
# because Row Level Security (set up in the database step) controls data access.
# NEVER put the "service_role" key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

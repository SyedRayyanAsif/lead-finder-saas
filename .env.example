# Copy this file to `.env.local` and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API Keys
#
# Use the PUBLISHABLE key (starts with sb_publishable_). Older projects call it
# the "anon" key - either works, which is why the variable is still named ANON.
# It is safe to ship in the browser because Row Level Security (set up in the
# database step) controls data access.
# NEVER put the SECRET key (sb_secret_...), the old "service_role" key, or your
# database password in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
